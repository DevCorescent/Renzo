# DATABASE
DATABASE_URL="postgresql://username:password@localhost:5432/renzo_db"
# DATABASE_URL="postgresql://username:password@host:5432/database"

# AUTH
JWT_SECRET="your-dummy-jwt-secret-change-me"

# Cloudflare R2
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="renzo-dummy-bucket"
R2_PUBLIC_URL="https://example-r2-public-url.com"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# NextAuth / Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"

# Groq AI
GROQ_API_KEY="your-groq-api-key"

# SMTP - Hosting / Email
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Renzo <your-email@example.com>"